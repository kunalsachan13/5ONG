# ==============================================================================
# 5ONG - Comprehensive Environment Configuration Template
# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# Do NOT commit `.env.local` or secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://5ong.app

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JWT tokens and user session cookies
AUTH_SECRET=your-32-char-random-auth-secret-key-here
JWT_SECRET=your-32-char-random-jwt-secret-key-here

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. NEON SERVERLESS POSTGRESQL DATABASE (https://neon.tech)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (recommended for serverless)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection string (used for migrations and schema pushes)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# ------------------------------------------------------------------------------
# 5. NEON AUTH & FUNCTIONS
# ------------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://ep-your-endpoint.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-your-endpoint.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=your-random-neon-auth-cookie-secret-key
NEON_FUNCTION_API_BASE_URL=https://br-your-endpoint-api.compute.us-east-2.aws.neon.tech

# ------------------------------------------------------------------------------
# 6. NEON OBJECT STORAGE (S3 Compatible Storage for user audio & avatars)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-access-key
AWS_ENDPOINT_URL_S3=https://br-your-storage-bucket.storage.us-east-2.aws.neon.tech
AWS_REGION=us-east-2

# ------------------------------------------------------------------------------
# 7. FIREBASE CLIENT SDK (Real-time Firestore, Rooms, & Music Sync)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=i5ong-music
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=i5ong-music.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=i5ong-music
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=i5ong-music.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Firebase Admin SDK credentials (if server-side admin is used):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 8. EMAIL DELIVERY & OTP (Resend - https://resend.com)
# ------------------------------------------------------------------------------
# Required for sending passwordless OTP verification emails to users
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="5ONG <onboarding@resend.dev>"
